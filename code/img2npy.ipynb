   "source": [
    "data_x = []\n",
    "data_y = []\n",
    "for index, row in df_lbl.iterrows():\n",
    "    img = load_img(\"./dataset/aimg/\"+str(int(row['id_name']))+\".jpg\", target_size=(224, 224))  #224# this is a PIL image\n",
    "#     img.thumbnail((50, 50))\n",
    "    # Convert to Numpy Array\n",
    "    x = img_to_array(img)\n",
    "#     x = x.reshape((3, 120, 160))\n",
    "    # Normalize\n",
    "#     x = (x - 128.0) / 128.0\n",
    "    x = (x ) / 255.0\n",
    "    data_x.append(x)\n",
    "    data_y.append(int(row['relation']))\n",
    "    if index > 30000:\n",
    "        break\n",
    "    if index % 1000 == 0:\n",
    "        print(\"%d images to array\" % index)\n",
    "print(\"All images to array!\")"
   ]
